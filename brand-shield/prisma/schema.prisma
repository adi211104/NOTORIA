generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   String        @id @default(cuid())
  email                String        @unique
  password             String
  nombre               String
  telefono             String?
  idioma               String        @default("es") // "es" | "en" — preferencia de idioma (dashboard, PDF, emails)
  googleId             String?       @unique
  emailVerificado      Boolean       @default(false)
  tokenVerificacion    String?       @unique
  tokenVerificaExpira  DateTime?
  // Recuperación de contraseña ("olvidé mi contraseña"): token de un solo uso con
  // expiración corta. Se guarda el HASH del token, no el token en claro, para que
  // una filtración de la BD no permita resetear contraseñas. Índice normal (no
  // @unique) para agilizar el lookup por hash sin necesidad de constraint única —
  // el token es aleatorio de 256 bits, la colisión es prácticamente imposible.
  tokenResetHash       String?
  tokenResetExpira     DateTime?
  // Versión de las sesiones. Va dentro del JWT como `v`; si el token trae una
  // versión distinta de esta, `auth.middleware` lo rechaza.
  //
  // Sirve para lo que un JWT no puede hacer por sí solo: caducar antes de tiempo.
  // Hasta ahora, cambiar la contraseña NO expulsaba a nadie — quien te hubiera
  // robado la sesión seguía dentro 7 días más, que es justo el caso en el que
  // cambias la contraseña. Se incrementa al cambiarla, al restablecerla y al
  // pulsar "cerrar sesión en todos los dispositivos".
  //
  // ⚠️ Los tokens emitidos ANTES de esta columna no llevan `v`. El middleware los
  // trata como versión 0, que es este default: así el despliegue no echa a nadie,
  // y en cuanto alguien cambia su contraseña sus sesiones viejas mueren.
  tokenVersion         Int           @default(0)
  plan                 Plan          @default(GRATIS)
  suscripcionId        String?
  suscripcionActiva    Boolean       @default(false)
  fechaVencimiento     DateTime?
  periodoFacturacion   String? // "mensual" | "anual" — ciclo activo, lo usa el cron de renovación para saber qué monto y qué plazo cobrar
  promoBienvenidaUsada Boolean       @default(false) // 50% off los primeros 2 meses en plan mensual — una sola vez por cuenta, se marca en el primer cobro aunque luego cancele
  mesesPromoRestantes  Int           @default(0) // cuántas renovaciones mensuales aún faltan cobrar con el 50% de la promo de bienvenida
  // Contador semanal de respuestas generadas con IA (se reinicia cada semana)
  iaUsos               Int           @default(0)
  iaSemana             String?
  // Preferencias de notificación de alertas:
  // { tipos: { PICO_RESENAS_NEGATIVAS, CAIDA_RATING, CUENTAS_NUEVAS, RESENA_MUY_NEGATIVA }: bool,
  //   umbralNegativas: 1|5, frecuencia: 'INMEDIATA'|'SEMANAL'|'MENSUAL', diaSemana: 0-6 }
  prefsAlertas         Json?
  // Secuencia de emails de onboarding (drip): 0 = ninguno enviado, 1 = día 2,
  // 2 = día 5, 3 = día 7 (fin). El worker solo procesa cuentas creadas hace
  // menos de 30 días, así el default 0 en cuentas viejas no dispara nada.
  dripEtapa            Int           @default(0)
  // Datos fiscales del receptor del comprobante. Se piden al suscribirse y se
  // congelan dentro de cada Comprobante al emitirlo (si el usuario luego los
  // corrige, los comprobantes ya emitidos no cambian — eso sería adulterarlos).
  // docTipo sigue el catálogo 06 de SUNAT: "6" RUC, "1" DNI, "0" no domiciliado.
  docTipo              String?
  docNumero            String?
  razonSocial          String? // razón social o nombre completo tal como debe salir en el comprobante
  direccionFiscal      String?
  paisFiscal           String? // ISO 3166-1 alpha-2 en MAYÚSCULA (ej. "PE"). Determina si la venta lleva IGV o es exportación de servicios.
  negocios             Negocio[]
  pagos                Pago[]
  comprobantes         Comprobante[]
  // Equipo. `equipo` son las personas que este usuario invitó a SU cuenta;
  // `membresias` son las cuentas ajenas a las que él tiene acceso. Los dos
  // lados existen porque una misma persona puede ser dueña de su restaurante e
  // invitada en el de un socio.
  equipo               Miembro[]           @relation("EquipoDeLaCuenta")
  membresias           Miembro[]           @relation("MembresiasDelUsuario")
  invitaciones         Invitacion[]        @relation("InvitacionesDeLaCuenta")
  actividad            RegistroActividad[] @relation("ActividadDeLaCuenta")
  creadoEn             DateTime      @default(now())
  actualizadoEn        DateTime      @updatedAt

  @@index([tokenResetHash])
  @@map("usuarios")
}

enum Plan {
  GRATIS
  NEGOCIO
  FRANQUICIA
}

// Historial de cobros de Culqi — se guarda un registro por cada intento de
// cobro (inicial o renovación mensual) para que el usuario pueda corroborar
// en Facturación cuánto pagó, cuándo y con qué tarjeta. Solo se guardan los
// primeros 4 dígitos de la tarjeta (identifican el banco emisor, no la
// tarjeta en sí) — nunca el número completo ni el CVV.
model Pago {
  id            String       @id @default(cuid())
  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id])
  plan          Plan
  periodo       String // "mensual" | "anual"
  tipo          String // "INICIAL" | "RENOVACION"
  estado        String // "EXITOSO" | "FALLIDO" | "REEMBOLSADO"
  monto         Int // en céntimos, misma unidad que Culqi
  // Los precios de los planes están en soles (7500 = S/75.00) y los cargos se
  // hacen en PEN. Ambos call-sites (pago.routes.js y el cron de renovación)
  // pasan la moneda explícita desde lib/precios.js; este default es solo la red
  // de seguridad. Ojo al cambiarlo: si el default y lib/precios.js discrepan, un
  // plan de S/75 se cobraría como US$75.
  moneda        String       @default("PEN")
  titular       String // nombre del titular al momento del cobro
  tarjetaInicio String? // primeros 4 dígitos de la tarjeta
  tarjetaMarca  String? // visa / mastercard / etc. (Culqi: source.iin.card_brand)
  culqiCargoId  String?      @unique
  comprobante   Comprobante?
  creadoEn      DateTime     @default(now())

  @@index([usuarioId])
  @@map("pagos")
}

// Correlativo por serie. Una fila por serie ("V001", "F001", "B001"); el
// correlativo se incrementa con un UPDATE ... RETURNING atómico (ver
// services/comprobante.service.js) para que dos cobros simultáneos no puedan
// tomar el mismo número. SUNAT exige numeración consecutiva y sin huecos.
model SerieComprobante {
  id            String   @id @default(cuid())
  tipo          String // "VOUCHER" | "FACTURA" | "BOLETA"
  serie         String   @unique
  correlativo   Int      @default(0) // último número emitido
  actualizadoEn DateTime @updatedAt

  @@map("series_comprobante")
}

// Comprobante emitido por cada cobro exitoso.
//
// FASE A (actual): se emite tipo "VOUCHER" (serie V001) — una constancia de
// pago interna, con todo el desglose tributario ya calculado, pero que NO es un
// comprobante de pago electrónico y así lo dice el PDF. Los correlativos
// fiscales (F001/B001) se dejan sin usar a propósito: reservar números que
// todavía no se pueden enviar a SUNAT crearía huecos en la numeración.
//
// FASE B: al activar el envío a SUNAT se cambia la serie configurada y el mismo
// código emite FACTURA/BOLETA reales; los campos estadoSunat/hashFirma se
// llenan con la respuesta del CDR.
model Comprobante {
  id        String  @id @default(cuid())
  pagoId    String  @unique
  pago      Pago    @relation(fields: [pagoId], references: [id])
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo        String // "VOUCHER" | "FACTURA" | "BOLETA"
  serie       String
  correlativo Int
  numero      String @unique // "V001-00000001" — lo que se muestra e imprime

  // Receptor congelado al momento de la emisión
  receptorTipoDoc   String // catálogo 06: "6" RUC, "1" DNI, "0" no domiciliado
  receptorNumDoc    String?
  receptorNombre    String
  receptorDireccion String?
  receptorPais      String // ISO alpha-2 en mayúscula

  // Importes en céntimos de `moneda`, mismo criterio que Pago.monto.
  // El precio publicado INCLUYE IGV: para un cliente peruano $20 se desglosa en
  // gravadas $16.95 + igv $3.05; para uno del exterior va entero a exportacion.
  moneda        String
  gravadas      Int    @default(0) // base imponible de operaciones gravadas
  exportacion   Int    @default(0) // operaciones de exportación de servicios
  igv           Int    @default(0)
  total         Int
  tipoOperacion String // catálogo 51: "0101" venta interna · "0201" exportación de servicios

  descripcion  String
  fechaEmision DateTime @default(now())

  // Ciclo SUNAT — "NO_APLICA" mientras se emitan vouchers (Fase A)
  //   PENDIENTE  en cola de envío
  //   ACEPTADO   con CDR conforme; recién aquí el comprobante existe para SUNAT
  //   RECHAZADO  SUNAT lo rechazó; hay que corregir y reemitir, no reintentar
  //   VENCIDO    se pasó el plazo legal de 3 días sin ser aceptado
  estadoSunat  String  @default("NO_APLICA") // NO_APLICA | PENDIENTE | ACEPTADO | RECHAZADO | VENCIDO | ANULADO
  sunatCodigo  String?
  sunatMensaje String?
  hashFirma    String? // DigestValue de la firma — va en el QR de la representación impresa

  // El XML firmado y el CDR deben conservarse 5 años. Se guardan aquí y no en
  // disco porque el sistema de archivos de Railway es efímero. A este volumen
  // (~10 KB por comprobante) la base de datos es el sitio más simple y seguro;
  // si el volumen crece mucho, migrar a almacenamiento de objetos.
  xmlFirmado String? @db.Text
  cdrXml     String? @db.Text

  // Control de la cola de envío
  intentosEnvio    Int       @default(0)
  ultimoIntentoEn  DateTime?
  proximoIntentoEn DateTime?
  enviadoEn        DateTime? // momento en que SUNAT lo aceptó
  // Plazo legal: 3 días calendario contados desde el día siguiente a la emisión.
  // Pasado ese punto el comprobante pierde validez tributaria aunque ya se le
  // haya entregado al cliente, así que se calcula al emitir y se vigila.
  fechaLimiteEnvio DateTime?

  // Resumen diario que informó esta boleta. Nulo en las facturas, que se envían
  // una a una, y en las boletas que aún no han entrado en ningún resumen.
  resumenId String?
  resumen   ResumenSunat? @relation(fields: [resumenId], references: [id])

  creadoEn DateTime @default(now())

  @@unique([serie, correlativo])
  @@index([usuarioId])
  @@index([estadoSunat, proximoIntentoEn])
  @@index([resumenId])
  @@map("comprobantes")
}

// Envío agrupado a SUNAT: resumen diario de boletas (RC) y comunicación de baja
// de facturas (RA).
//
// Existe como tabla aparte, y no como campos en Comprobante, porque un resumen
// agrupa MUCHAS boletas bajo un solo envío: el ticket, el CDR y el veredicto son
// del resumen, no de cada boleta.
//
// ⚠️ El TICKET es la razón de ser de este modelo. `sendSummary` no devuelve el
// CDR sino un ticket, y el veredicto se pide después con `getStatus`. Si el
// proceso se cae entre el envío y la consulta y el ticket no está guardado, no
// hay forma de saber si SUNAT aceptó, y reenviar el resumen produciría un
// duplicado. Por eso se persiste antes de dar el envío por terminado.
model ResumenSunat {
  id String @id @default(cuid())

  tipo            String // "RC" resumen diario de boletas · "RA" comunicación de baja
  identificador   String   @unique // "RC-20260806-1" — es también el nombre del archivo
  correlativo     Int
  // Día de emisión de los comprobantes que agrupa. Un resumen informa un solo
  // día: es lo que viaja en cbc:ReferenceDate.
  fechaReferencia DateTime

  // PENDIENTE   construido, todavía sin enviar
  // EN_PROCESO  enviado; SUNAT dio ticket y falta pedirle el veredicto
  // ACEPTADO    con CDR conforme; recién aquí las boletas existen para SUNAT
  // RECHAZADO   SUNAT lo rechazó; hay que corregir y rehacerlo
  // VENCIDO     se pasó el plazo legal sin ser aceptado
  estado       String  @default("PENDIENTE")
  ticket       String?
  sunatCodigo  String?
  sunatMensaje String?

  // Se conservan 5 años, igual que los del comprobante y por el mismo motivo
  xmlFirmado String? @db.Text
  cdrXml     String? @db.Text

  intentosEnvio    Int       @default(0)
  ultimoIntentoEn  DateTime?
  proximoIntentoEn DateTime?
  enviadoEn        DateTime?
  // ⚠️ Plazo legal del resumen: 7 días calendario, NO los 3 de la factura. Son
  // relojes distintos; mezclarlos hace avisar tarde o avisar de más.
  fechaLimiteEnvio DateTime?

  creadoEn DateTime @default(now())

  comprobantes Comprobante[]

  @@index([estado, proximoIntentoEn])
  @@map("resumenes_sunat")
}

model Negocio {
  id            String      @id @default(cuid())
  nombre        String
  tipo          TipoNegocio
  // Código de país ISO 3166-1 alpha-2 en minúscula (ej. "pe"). Nulo en negocios
  // creados antes de esta columna — no se hace backfill retroactivo.
  pais          String?
  activo        Boolean     @default(true)
  direccion     String?
  colorEtiqueta String?     @default("#6366f1")
  ultimoEscaneo DateTime?

  // Automatizaciones — gating por plan (ver middlewares/verificarPlan)
  resumenSemanalActivo   Boolean @default(true)
  autoRespuestaActiva    Boolean @default(false)
  autoRespuestaPlantilla String? // texto aprobado por el usuario, con placeholder {{autor}}
  autoRespuestaTono      String? // "formal" | "cercano" | "disculpa" — solo plan Franquicia

  // Último insight IA del resumen semanal — cacheado para mostrarlo en el
  // tooltip del semáforo del dashboard sin llamar a Groq en cada carga
  ultimoInsightSemanal String?
  ultimoInsightFecha   DateTime?

  // Términos extra a buscar en la escucha de menciones, separados por coma
  // (handle de la marca, hashtags propios, variantes del nombre mal escrito).
  // Vacío = se busca solo por `nombre`. Ver src/scrapers/menciones.js
  terminosMencion  String?
  // Activa la escucha de menciones para este negocio. Por defecto encendida:
  // las fuentes ya traen su propio guard, así que sin credenciales no hace nada.
  mencionesActivas Boolean @default(true)

  // Última foto de los datos de la ficha de Google que vigilamos: teléfono,
  // horario, nombre y dirección. Es la referencia contra la que se compara en
  // cada escaneo para detectar que alguien la alteró (ver lib/fichaGoogle.js).
  //
  // Forma: { telefono, direccion, nombre, horarioHash, horarioTexto }
  //
  // ⚠️ Esto vivía en una fila de `Alerta` marcada como de control, porque añadir
  // esta columna exigía un `prisma db push` que Railway no corre en el deploy.
  // Funcionaba, pero ensuciaba una tabla que significa "cosas que contarle al
  // dueño" y obligaba a filtrarla en SEIS consultas distintas — la lista del
  // panel, el contador, el detalle, el resumen por correo, el PDF y el drip. Un
  // solo sitio que se olvidara y el cliente veía una alerta que no existía.
  fichaGoogleRef Json?

  googlePlaceId    String?
  googleNombre     String?
  googleRatingBase Float?

  facebookPageId      String?
  facebookAccessToken String?
  facebookTokenExpira DateTime?

  // Instagram (Meta Graph API) — pendiente de aprobación de la app en Meta
  instagramUserId      String?
  instagramAccessToken String?
  instagramTokenExpira DateTime?

  // TikTok — Display API (open.tiktokapis.com). Da perfil y videos, NO comentarios.
  // Queda como respaldo: la conexión principal es la Accounts API de abajo.
  tiktokOpenId       String?
  tiktokAccessToken  String?
  tiktokRefreshToken String?
  tiktokTokenExpira  DateTime?

  // TikTok — Accounts API (business-api.tiktok.com). Es la conexión PRINCIPAL:
  // cubre perfil, videos, lectura de comentarios y respuestas (§15-octies).
  // `tiktokBizId` es el business_id, que resulta ser el `open_id` del canje.
  tiktokBizId           String?
  tiktokBizAccessToken  String?
  tiktokBizRefreshToken String?
  tiktokBizTokenExpira  DateTime?

  // Perfil visible de la cuenta conectada, cacheado para no llamar a TikTok en
  // cada carga del panel. COMPARTIDO por las dos conexiones a propósito: es la
  // misma cuenta de TikTok mostrada en el mismo sitio, así que duplicar estos
  // cuatro campos solo crearía dos versiones que se contradicen.
  // El @ solo se llena con el scope user.info.profile (que la Accounts API sí
  // tiene concedido; la Display no).
  tiktokNombre    String?
  tiktokAvatar    String?
  tiktokUsername  String?
  tiktokPerfilUrl String?

  // TripAdvisor (Content API) — pendiente de API key. No usa OAuth por negocio,
  // solo el locationId público (ver src/scrapers/tripadvisor.scraper.js)
  tripadvisorLocationId String?
  tripadvisorUrl        String?
  tripadvisorRatingBase Float?

  // Google Business Profile
  gbpAccessToken  String?
  gbpRefreshToken String?
  gbpAccountId    String?
  gbpLocationId   String?
  gbpConectadoEn  DateTime?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  resenas      Resena[]
  alertas      Alerta[]
  snapshots    Snapshot[]
  competidores Competidor[]
  menciones    Mencion[]
  comentarios  ComentarioSocial[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("negocios")
}

enum TipoNegocio {
  RESTAURANTE
  BAR
  CAFETERIA
  HOTEL
  PELUQUERIA
  SPA
  GIMNASIO
  CLINICA
  TIENDA
  INMOBILIARIA
  TALLER
  OTRO
}

model Resena {
  id                String     @id @default(cuid())
  plataforma        Plataforma
  externalId        String
  rating            Int
  texto             String?
  autorNombre       String?
  autorFoto         String?
  autorResenasTotal Int?
  fechaResena       DateTime
  esSospechosa      Boolean    @default(false)
  motivoSospecha    String?
  // Facebook no tiene estrellas desde 2018, tiene recomendaciones. El scraper
  // traduce positive → 5 y negative → 1 para que el detector y el promedio
  // funcionen igual que con las demás fuentes, pero eso es una conversión
  // nuestra, no un dato que diera la plataforma.
  //
  // 🔴 `true` significa «esta puntuación la derivamos nosotros». Sin la columna,
  // el scraper la calculaba y se tiraba, y el panel enseñaría «5★» de algo que
  // en Facebook solo dice «recomienda» — una precisión que no existe. Es null
  // para las fuentes que sí dan estrella de verdad, que son todas las demás.
  sinEstrella       Boolean?
  respondida        Boolean    @default(false)
  respuesta         String?
  // Evita reenviar la escalación de urgencia (24h sin responder) más de una vez
  escaladaUrgencia  Boolean    @default(false)
  negocioId         String
  negocio           Negocio    @relation(fields: [negocioId], references: [id])
  detectadaEn       DateTime   @default(now())

  @@unique([plataforma, externalId])
  @@map("resenas")
}

enum Plataforma {
  GOOGLE
  FACEBOOK
  TRIPADVISOR
  // Solo se usan en Alerta (comentarios y menciones). Resena y Snapshot nunca
  // los llevan: no hay rating ni conteo de reseñas del que tomar snapshot.
  TIKTOK
  INSTAGRAM
  // Huérfano a propósito: la fuente X/Twitter se eliminó del producto el
  // 2026-07-29 y ninguna fila usa este valor, pero el valor YA ESTÁ APLICADO en la
  // BD de producción. Borrarlo de un enum de Postgres no es un ALTER: obliga a
  // recrear el tipo y castear `resenas`, `snapshots` y `alertas` (Prisma genera un
  // DROP TYPE y pide --accept-data-loss). Riesgo real en prod a cambio de cero
  // beneficio visible. Se queda.
  TWITTER
}

model Snapshot {
  id                  String     @id @default(cuid())
  plataforma          Plataforma
  ratingActual        Float
  totalResenas        Int
  resenasNegativas24h Int        @default(0)
  negocioId           String
  negocio             Negocio    @relation(fields: [negocioId], references: [id])
  tomadoEn            DateTime   @default(now())

  @@map("snapshots")
}

model Alerta {
  id          String     @id @default(cuid())
  tipo        TipoAlerta
  plataforma  Plataforma
  descripcion String
  detalle     Json?
  leida       Boolean    @default(false)
  notificada  Boolean    @default(false)
  negocioId   String
  negocio     Negocio    @relation(fields: [negocioId], references: [id])
  creadaEn    DateTime   @default(now())

  @@map("alertas")
}

enum TipoAlerta {
  PICO_RESENAS_NEGATIVAS
  CAIDA_RATING
  CUENTAS_NUEVAS
  RESENA_MUY_NEGATIVA
  // Alguien habló mal de la marca fuera de su ficha. Antes esto se emitía como
  // RESENA_MUY_NEGATIVA con plataforma GOOGLE, que era falso y hacía que el
  // umbral "solo picos" de prefsAlertas lo silenciara sin querer.
  MENCION_NEGATIVA
  // Comentario negativo en una publicación propia del negocio. Distinto de
  // MENCION_NEGATIVA porque este SÍ se puede responder desde Notoria.
  COMENTARIO_NEGATIVO
  // Alguien tocó la FICHA de Google, no las reseñas: la marcó como cerrada, o le
  // cambió el teléfono, el horario, el nombre o la dirección. Google acepta esas
  // sugerencias de cualquiera y las aplica sin avisar al dueño.
  //
  // Hasta el 2026-08-17 esto viajaba como RESENA_MUY_NEGATIVA por no poder añadir
  // un valor al enum sin un `prisma db push`. Era mentira en la etiqueta del
  // panel y, peor, quedaba expuesto a que alguien apagara "reseña crítica" en sus
  // preferencias y dejara de enterarse de que su local aparece cerrado.
  FICHA_ALTERADA
}

model Competidor {
  id            String               @id @default(cuid())
  nombre        String
  googlePlaceId String
  ratingActual  Float?
  totalResenas  Int?
  negocioId     String
  negocio       Negocio              @relation(fields: [negocioId], references: [id])
  snapshots     SnapshotCompetidor[]
  creadoEn      DateTime             @default(now())

  @@map("competidores")
}

model SnapshotCompetidor {
  id           String     @id @default(cuid())
  ratingActual Float
  totalResenas Int
  competidorId String
  competidor   Competidor @relation(fields: [competidorId], references: [id])
  tomadoEn     DateTime   @default(now())

  @@map("snapshots_competidores")
}

// Comentarios que la gente deja en las PUBLICACIONES PROPIAS del negocio
// (sus videos de TikTok, sus posts de Instagram).
//
// Es el tercer tipo de contenido del sistema y conviene no confundirlos:
//   Resena           → en la ficha del negocio, TIENE rating (Google, Facebook)
//   ComentarioSocial → en una publicación PROPIA, sin rating, SÍ se responde
//                      desde Notoria (la API de la plataforma lo permite)
//   Mencion          → en el perfil de un TERCERO, sin rating, NO se responde
//                      desde acá (hay que ir a la plataforma)
//
// `plataforma` es String y no el enum Plataforma por lo mismo que Mencion: ese
// enum lo comparten Resena/Snapshot, donde solo caben fuentes con rating.
// Valores: "TIKTOK" | "INSTAGRAM".
model ComentarioSocial {
  id          String  @id @default(cuid())
  plataforma  String
  // Prefijado por fuente por los scrapers ("tt_", "ig_") — el @unique es global
  externalId  String  @unique
  texto       String
  autorNombre String?

  // Publicación donde vive el comentario. `publicacionId` NO es opcional en la
  // práctica: la API de TikTok exige el video_id para poder responder, así que
  // sin este dato el comentario queda como solo-lectura.
  publicacionId     String?
  publicacionTitulo String?

  sentimiento         String?
  respondida          Boolean @default(false)
  respuesta           String?
  // Id que TikTok le dio a NUESTRA respuesta. Sin él no se puede borrar: es el
  // único identificador con el que la plataforma la reconoce. Queda null en las
  // respuestas anteriores al 2026-08-06, que por eso no se pueden retirar desde
  // el panel — el worker lo rellena al detectarlas en el hilo.
  respuestaExternalId String?
  // Moderación hecha en la plataforma (§15-octies). Se guardan para que los
  // botones del panel muestren el estado real al recargar; el worker los
  // resincroniza en cada escaneo por si el dueño moderó desde la app de TikTok.
  oculto              Boolean @default(false)
  fijado              Boolean @default(false)
  vista               Boolean @default(false)
  // Evita re-alertar el mismo comentario en cada ciclo del worker
  notificada          Boolean @default(false)

  fechaComentario DateTime?
  negocioId       String
  negocio         Negocio   @relation(fields: [negocioId], references: [id])
  detectadoEn     DateTime  @default(now())

  @@index([negocioId, detectadoEn])
  @@map("comentarios_sociales")
}

// Contenido de terceros que habla de la marca (a diferencia de Resena, que es
// contenido dejado EN la ficha del negocio). No lleva rating ni se responde
// desde acá: se responde en la plataforma de origen.
//
// `plataforma` es String y no el enum Plataforma a propósito: el enum lo comparten
// Resena/Snapshot/Alerta, donde solo tienen sentido las fuentes con rating.
// Valor usado: "TIKTOK". (Hubo una fuente "TWITTER" que se eliminó del producto
// el 2026-07-29 — ver §18 del CLAUDE.md.)
model Mencion {
  id          String  @id @default(cuid())
  plataforma  String  @default("TIKTOK")
  // Se prefija por fuente ("tt_") para que el @unique global no colisione entre
  // plataformas si algún día hay más de una — ver src/scrapers/*Menciones*.
  externalId  String  @unique
  texto       String
  autorNombre String?
  autorHandle String?
  url         String?
  sentimiento String?

  // Fecha de publicación en el origen. Distinta de detectadaEn: un video puede
  // ser de hace un mes y recién aparecer en la primera búsqueda.
  fechaMencion DateTime?
  // Título/descripción del video o post — da contexto sin salir del panel
  contexto     String?
  // { vistas, likes, comentarios, compartidos } — se usa para priorizar lo viral.
  // Json porque cada fuente reporta métricas distintas.
  metricas     Json?

  vista      Boolean @default(false)
  archivada  Boolean @default(false)
  // Evita re-alertar la misma mención en cada ciclo del worker
  notificada Boolean @default(false)

  negocioId   String
  negocio     Negocio  @relation(fields: [negocioId], references: [id])
  detectadaEn DateTime @default(now())

  @@index([negocioId, archivada, detectadaEn])
  @@map("menciones")
}

// Libro de Reclamaciones virtual (Ley 29571, D.S. 101-2022-PCM).
//
// INDECOPI exige que viva DENTRO de la web, no en un formulario externo tipo
// Google Forms — Culqi observó la web justamente por eso. De ahí que esto sea
// una tabla propia y no un correo suelto: la norma obliga a conservar cada hoja
// por 2 años, a numerarlas de forma correlativa y a poder mostrarlas ante una
// fiscalización.
//
// No tiene relación con Usuario a propósito: cualquier consumidor puede
// reclamar, esté registrado o no.
model Reclamacion {
  id     String @id @default(cuid())
  // Correlativo visible que se le entrega al consumidor (ej. "2026-000123").
  // Único porque es el cargo de recepción: dos hojas con el mismo número
  // invalidarían el libro.
  numero String @unique

  // ── Consumidor ──
  nombre    String
  documento String // DNI / CE / pasaporte
  docTipo   String  @default("DNI")
  domicilio String
  email     String
  telefono  String
  // La norma obliga a identificar al apoderado cuando el consumidor es menor
  esMenor   Boolean @default(false)
  apoderado String?

  // ── Bien contratado ──
  tipoBien    String @default("SERVICIO") // PRODUCTO | SERVICIO
  descripcion String // qué se contrató
  montoS      Int? // monto reclamado en céntimos, opcional

  // ── Detalle ──
  // RECLAMO = disconformidad con el servicio · QUEJA = malestar con la atención.
  // Son figuras distintas en la ley y los plazos difieren, por eso se guarda.
  tipo    String @default("RECLAMO")
  detalle String
  pedido  String

  // ── Respuesta del proveedor ──
  // El plazo legal de respuesta es de 15 días hábiles desde la recepción.
  estado       String    @default("PENDIENTE") // PENDIENTE | RESPONDIDO
  respuesta    String?
  respondidoEn DateTime?

  creadoEn DateTime @default(now())
  ip       String?

  @@index([estado, creadoEn])
  @@map("reclamaciones")
}

// Tarjetas que ya consumieron la promo de bienvenida (50% los 2 primeros meses).
//
// El flag `Usuario.promoBienvenidaUsada` solo impide reclamarla dos veces con la
// MISMA cuenta: crear otra cuenta con otro correo bastaba para repetirla
// indefinidamente. Este registro la ata además al medio de pago, que es mucho
// más caro de multiplicar que un correo.
//
// Se guarda un HMAC de BIN + últimos 4 dígitos, nunca el número: son los únicos
// datos de tarjeta que Culqi devuelve y que se pueden almacenar, y el hash evita
// que la tabla sirva para reconstruir nada.
//
// ⚠️ El secreto del HMAC (PROMO_HASH_SECRET) NO se puede rotar sin vaciar esta
// tabla: cambiarlo hace que ninguna huella anterior vuelva a coincidir y la
// promo se podría reclamar de nuevo con las mismas tarjetas.
model PromoTarjeta {
  id     String @id @default(cuid())
  // HMAC-SHA256 de "bin|last4". Único: es la condición que impide repetir.
  huella String @unique

  // Con qué cuenta se usó. Sirve para auditar un patrón de abuso, no para la
  // validación (esa es la huella).
  usuarioId String
  usadaEn   DateTime @default(now())

  @@index([usuarioId])
  @@map("promo_tarjetas")
}

// ─────────────────────────────────────────────────────────────────────────────
// Equipo: compartir la cuenta de una empresa
// ─────────────────────────────────────────────────────────────────────────────

// Una persona con acceso a la cuenta de OTRA.
//
// ⚠️ El PROPIETARIO no tiene fila aquí. Es el propio `Usuario` del que cuelgan
// los negocios, y su rol se sintetiza en el middleware. Se decidió así por dos
// motivos que conviene no deshacer:
//
//   1. Evita una migración de datos. Si el dueño fuera una fila de `Miembro`,
//      habría que crear una por cada cuenta existente, y una migración que
//      falle a medias deja a alguien sin acceso a su propia cuenta.
//   2. La propiedad sigue siendo lo que ya era: `Negocio.usuarioId`. Las ~40
//      consultas del panel siguen preguntando exactamente lo mismo, solo que
//      ahora preguntan por `req.cuenta.id` en vez de `req.usuario.id`.
//
// Corolario: `Usuario` = la persona que inició sesión. `cuenta` = la empresa en
// la que está trabajando ahora mismo. Casi siempre son la misma; cuando no lo
// son, es porque alguien la invitó.
model Miembro {
  id String @id @default(cuid())

  // La cuenta compartida: el Usuario que paga y de quien cuelgan los negocios.
  cuentaId String
  cuenta   Usuario @relation("EquipoDeLaCuenta", fields: [cuentaId], references: [id])

  // La persona invitada. Tiene su propio correo y su propia contraseña — el
  // objetivo entero de esto es que nadie más tenga que usar la del dueño.
  usuarioId String
  usuario   Usuario @relation("MembresiasDelUsuario", fields: [usuarioId], references: [id])

  rol RolMiembro

  // Alcance. Vacío = todos los negocios de la cuenta. Con ids = solo esos, que
  // es lo que le da sentido al plan Franquicia: el encargado de una sede no
  // tiene por qué leer las reseñas de las otras nueve.
  //
  // Lista de ids y no tabla intermedia porque nunca se consulta al revés ("qué
  // miembros ven este negocio" no aparece en ninguna consulta caliente), así
  // que el alcance viaja entero en la misma fila que ya se está leyendo.
  //
  // ⚠️ Un negocio borrado deja su id aquí. Es inofensivo — el filtro es un
  // `IN` contra negocios que existen — y limpiarlo obligaría a recorrer todos
  // los miembros en cada borrado.
  negociosIds String[] @default([])

  creadoEn DateTime @default(now())

  @@unique([cuentaId, usuarioId])
  @@index([usuarioId])
  @@map("miembros")
}

enum RolMiembro {
  GESTOR
  LECTOR
}

// Invitación pendiente. Se borra al aceptarse (pasa a ser un `Miembro`).
model Invitacion {
  id       String  @id @default(cuid())
  cuentaId String
  cuenta   Usuario @relation("InvitacionesDeLaCuenta", fields: [cuentaId], references: [id])

  // Normalizado a minúsculas, igual que en auth.routes.js: en Postgres el
  // índice único distingue mayúsculas, y una invitación que no case con el
  // correo de la cuenta creada es una invitación que nunca se puede aceptar.
  email       String
  rol         RolMiembro
  negociosIds String[]   @default([])

  // Se guarda el HASH del token, no el token. Mismo criterio que el de
  // recuperación de contraseña: una filtración de la base no puede entregar
  // enlaces de acceso a cuentas ajenas.
  tokenHash String   @unique
  expira    DateTime

  invitadaPorId String?
  creadoEn      DateTime @default(now())

  @@unique([cuentaId, email])
  @@index([email])
  @@map("invitaciones")
}

// Quién hizo qué dentro de una cuenta compartida.
//
// Es la contrapartida de compartir: si tres personas responden reseñas desde el
// mismo panel, "se respondió" deja de ser una respuesta. Solo se registran
// acciones que CAMBIAN algo —hacia el cliente final o hacia el equipo—; leer no
// se registra, sería un volumen enorme por cero valor.
model RegistroActividad {
  id       String  @id @default(cuid())
  cuentaId String
  cuenta   Usuario @relation("ActividadDeLaCuenta", fields: [cuentaId], references: [id])

  usuarioId String
  // Nombre congelado al momento de la acción. Si esa persona sale del equipo o
  // borra su cuenta, el registro sigue diciendo quién fue — que es justamente
  // para lo que existe.
  autorNombre String

  accion    String // "responder_resena" | "responder_comentario" | ...
  negocioId String?
  detalle   Json?

  creadoEn DateTime @default(now())

  @@index([cuentaId, creadoEn])
  @@map("registro_actividad")
}
