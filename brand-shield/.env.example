# ── Base de datos (Railway PostgreSQL) ──────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria_min_32_chars
JWT_EXPIRES_IN=7d

# ── Google APIs ──────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIzaSy...
GOOGLE_CLIENT_ID=XXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://api.usenotoria.app/api/auth/google-business/callback

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Notoria <hola@usenotoria.app>

# ── Culqi (pagos) ────────────────────────────────────────
# El entorno lo decide el prefijo de la llave, no una variable aparte:
# pk_test_/sk_test_ = pruebas (no mueve dinero) · pk_live_/sk_live_ = cobros reales.
# En local van SIEMPRE las de test; las live solo en Railway.
# Validar el circuito con: node scripts/prueba-culqi.js
CULQI_PUBLIC_KEY=pk_test_...
CULQI_SECRET_KEY=sk_test_...
# Secreto propio para validar el webhook (agrégalo también al final de la URL
# que registres en el panel de Culqi: https://.../api/pagos/culqi/webhook?secret=...)
CULQI_WEBHOOK_SECRET=

# ── Telegram Bot ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...

# ── URLs ─────────────────────────────────────────────────
# URL del frontend en producción
FRONTEND_URL=https://usenotoria.app
# URL del propio backend (para CORS)
BACKEND_URL=https://api.usenotoria.app

# ── Entorno ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Groq — respuestas con IA (https://console.groq.com/keys)
GROQ_API_KEY=

# Meta / Instagram (pendiente de aprobacion de la app)
# Redirect URI a registrar en Meta for Developers (por defecto BACKEND_URL + esta ruta):
# https://api.usenotoria.app/api/redes/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Solo apps tipo Negocio con Facebook Login for Business: ID de la
# "Configuración" (paquete de permisos) creada en la consola. Si está seteado,
# el diálogo OAuth manda config_id y Meta ignora el scope suelto.
META_LOGIN_CONFIG_ID=
# Webhook de comentarios de Instagram. Cadena al azar que se elige una vez
# (openssl rand -hex 16) y se pega IGUAL en Railway y en Meta > Webhooks:
# Meta la manda en el handshake y el endpoint la compara. Sin ella el
# handshake responde 403 a proposito y Meta no guarda la URL.
# URL de devolucion de llamada: https://api.usenotoria.app/api/webhooks/instagram
META_WEBHOOK_VERIFY_TOKEN=

# TikTok (pendiente de aprobacion de la app)
# Redirect URI a registrar en TikTok for Developers (por defecto BACKEND_URL + esta ruta):
# https://api.usenotoria.app/api/redes/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# TripAdvisor Content API (pendiente de solicitar key — sin OAuth, una sola
# key para toda la app). Ver src/scrapers/tripadvisor.scraper.js
TRIPADVISOR_API_KEY=

# ── Comprobantes / SUNAT ─────────────────────────────────
# Buzón de la empresa que recibe copia de cada comprobante emitido, para el
# control tributario mensual. Si se deja vacío, solo se envía al cliente.
EMAIL_CONTABILIDAD=
# Domicilio fiscal tal como figura en la ficha RUC — SUNAT lo contrasta contra el
# comprobante. Solo la calle: el distrito, la provincia y el departamento están
# fijos en src/lib/tributario.js. Si se deja vacío usa el valor por defecto de ahí.
EMISOR_DIRECCION=
# Ubigeo del INEI del domicilio fiscal (070104 = La Perla, Callao)
EMISOR_UBIGEO=

# FASE B — mientras esté en false (o sin definir) se emiten VOUCHER (serie V001),
# una constancia interna que el PDF declara explícitamente como NO comprobante de
# pago electrónico. Ponerlo en true SOLO cuando el envío a SUNAT esté funcionando:
# a partir de ahí se consumen correlativos fiscales F001/B001, y un número emitido
# que nunca llega a SUNAT deja un hueco en la numeración.
SUNAT_EMISION_ACTIVA=false
# Certificado Digital Tributario (.p12) en base64 — NUNCA el archivo en el repo.
# Generar con: base64 -w0 certificado.p12
SUNAT_CERT_P12_BASE64=
SUNAT_CERT_PASSWORD=
# Alternativa solo para desarrollo local: ruta a un .p12 en disco. En producción
# usa siempre SUNAT_CERT_P12_BASE64 (el disco de Railway es efímero y público al
# contenedor). Si ambas están definidas, gana la base64.
SUNAT_CERT_P12_PATH=

# Usuario SOL SECUNDARIO con permiso solo de emisión de comprobantes (nunca el principal)
SUNAT_SOL_USUARIO=
SUNAT_SOL_CLAVE=

# "beta" (por defecto) o "produccion". Beta es el entorno de pruebas de SUNAT y
# acepta certificados autofirmados; sus credenciales públicas son el RUC
# 20000000001 con usuario MODDATOS / clave moddatos.
SUNAT_ENTORNO=beta
# Solo para probar contra beta, que exige el RUC de pruebas. En producción,
# dejar vacío para que use el RUC real de NOTORIA E.I.R.L.
EMISOR_RUC=
